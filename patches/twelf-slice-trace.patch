diff --git a/src/global/slice-trace.sig b/src/global/slice-trace.sig
new file mode 100644
index 0000000..898d071
--- /dev/null
+++ b/src/global/slice-trace.sig
@@ -0,0 +1,12 @@
+(* Optional dependency trace for the Twelf/LF slicer. *)
+
+signature SLICE_TRACE =
+sig
+  val enabled : unit -> bool
+  val reset : unit -> unit
+  val flush : unit -> unit
+  val beginDecl : string * string -> unit
+  val setPhase : string -> unit
+  val clearPhase : unit -> unit
+  val recordConst : string -> unit
+end;
diff --git a/src/global/slice-trace.sml b/src/global/slice-trace.sml
new file mode 100644
index 0000000..c679b5a
--- /dev/null
+++ b/src/global/slice-trace.sml
@@ -0,0 +1,60 @@
+(* Optional dependency trace for the Twelf/LF slicer.
+ *
+ * Enable by setting TWELF_SLICE_TRACE=/path/to/trace.tsv before starting
+ * twelf-server.  The trace is written when loadFile finishes.
+ *)
+
+structure SliceTrace :> SLICE_TRACE =
+struct
+  fun tracePath () = OS.Process.getEnv "TWELF_SLICE_TRACE"
+
+  val decls : (string * string) list ref = ref []
+  val deps : (string * string * string) list ref = ref []  (* phase, decl, ref *)
+  val current : string option ref = ref NONE
+  val phase = ref "type"
+
+  fun enabled () = Option.isSome (tracePath ())
+
+  fun reset () =
+    (decls := [];
+     deps := [];
+     current := NONE;
+     phase := "type")
+
+  fun beginDecl (name, kind) =
+    if enabled () andalso name <> "_" then
+      (decls := (name, kind) :: (!decls);
+       current := SOME name;
+       phase := "type")
+    else
+      current := NONE
+
+  fun setPhase p =
+    if enabled () then phase := p else ()
+
+  fun clearPhase () =
+    if enabled () then phase := "type" else ()
+
+  fun recordConst name =
+    case (!current, tracePath ()) of
+      (SOME d, SOME _) =>
+        if name <> "_" then
+          deps := (!phase, d, name) :: (!deps)
+        else ()
+    | _ => ()
+
+  fun flush () =
+    case tracePath () of
+      NONE => ()
+    | SOME path =>
+        let
+          val out = TextIO.openOut path
+          fun line xs = TextIO.output (out, String.concatWith "\t" xs ^ "\n")
+        in
+          (TextIO.output (out, "# twelf-slice-trace v1\n");
+           List.app (fn (n, k) => line ["decl", n, k]) (List.rev (!decls));
+           List.app (fn (p, d, r) => line [p, d, r]) (List.rev (!deps));
+           TextIO.closeOut out)
+          handle _ => ()
+        end
+end;
